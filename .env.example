# Application
APP_NAME=Traffic AI
APP_ENV=development
APP_DEBUG=true

# API
# API_HOST=0.0.0.0
# API_PORT=8000

# AI
YOLO_MODEL=yolo26n.pt
AI_DEVICE=cpu # Options: "cpu" or "0"
AI_CONFIDENCE=0.5

# Video
VIDEO_SOURCE=0
VIDEO_OUTPUT_DIR=outputs

# Database
# DATABASE_URL=postgresql://postgres:postgres@localhost:5432/traffic_ai

# Redis
# REDIS_URL=redis://localhost:6379/0

# Logging
LOG_LEVEL=INFO